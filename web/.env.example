# Better-Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Generic OIDC (your IdP)
OIDC_DISCOVERY_URL=https://your-issuer.example/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPES=openid profile email

# Required for the account creation worker (read from project root .env in dev,
# but in Docker pass them through env_file or -e):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.6v
EMAIL_DOMAIN=
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
