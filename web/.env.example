# Better-Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Generic OIDC (your IdP)
OIDC_DISCOVERY_URL=https://your-issuer.example/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPES=openid profile email

# Required for the account creation worker:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.6v
EMAIL_DOMAIN=

# Postgres (compose sets this; for dev outside compose, point at your local pg)
DATABASE_URL=postgres://acctcreator:acctcreator@localhost:5432/acctcreator

# IMAP — Cloudflare Email Routing forwards everything for *@your-domain
# into this mailbox; the web server polls it and writes to Postgres.
IMAP_HOST=imap.fastmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=1

# Optional — auth header required by /api/mail/* if set
MAIL_API_TOKEN=
# When the lib runs OUTSIDE the web process, it polls this URL instead of CF
MAIL_API_URL=

# Legacy Cloudflare-Worker backend (kept as a fallback if MAIL_API_URL unset)
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
