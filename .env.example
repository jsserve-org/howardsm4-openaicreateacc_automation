# Variables consumed by docker-compose.yml / docker-compose.prod.yml.
# Copy to `.env` (gitignored) and fill in. Compose substitutes them into
# the `environment:` blocks of each service.

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_DB=acctcreator
POSTGRES_USER=acctcreator
POSTGRES_PASSWORD=acctcreator

# ── Better-Auth ───────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Dev escape hatch — enables email/password sign-up. Leave 'false' in prod.
DEV_PASSWORD_AUTH=false

# ── OIDC SSO ──────────────────────────────────────────────────────────
OIDC_DISCOVERY_URL=https://your-issuer.example/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# ── OpenRouter (AI agent) ─────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.6v

# ── Burner email + IMAP poller ────────────────────────────────────────
EMAIL_DOMAIN=
IMAP_HOST=imap.fastmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=1

# ── Browser ───────────────────────────────────────────────────────────
HEADLESS=true

# ── Legacy (CLI scripts only — not consumed by docker-compose) ────────
# Kept here so a `cp .env.example .env` followed by `node src/...` still
# works for the standalone CLI tools.
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
PASSWORD_PREFIX=TestPass!
DEFAULT_NAME_PREFIX=TestUser
BATCH_SIZE=1
DELAY_BETWEEN=30000
